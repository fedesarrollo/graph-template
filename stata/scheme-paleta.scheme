#include s2color

sequence 1500
label "Paleta estándar (turquesa, coral, ámbar, gris, naranja)"

* Estilo estándar de gráficas para Stata.
* Instalación: ver README (net install paleta, from(...))   y luego   set scheme paleta
* Colores en RGB; equivalen a paleta.json.

* --- Fondos
color background        white
color plotregion        white
color plotregion_line   white
color graphregion       white
color graphregion_line  white
color legend            white
color legend_line       white

* --- Texto
color heading           "51 51 51"
color subheading        "102 102 102"
color axis_title        "51 51 51"
color tick_label        "102 102 102"
color text              "51 51 51"
color body              "102 102 102"
color small_body        "102 102 102"
color key_label         "51 51 51"

* --- Ejes y cuadrícula (solo líneas horizontales)
color axisline          "168 168 168"
color tick              "168 168 168"
color grid              "224 224 224"
color major_grid        "224 224 224"
linewidth major_grid    thin
linewidth grid          thin
yesno draw_major_grid   no
yesno draw_major_hgrid  yes
yesno draw_major_vgrid  no
anglestyle vertical_tick horizontal

* --- Leyenda arriba
clockpos legend_position 12

* --- Series (paleta categórica)
color p1        "91 195 206"
color p1line    "91 195 206"
color p1lineplot "91 195 206"
color p1mark    "91 195 206"
color p1markfill "91 195 206"
color p1bar     "91 195 206"
color p1area    "91 195 206"
color p1box     "91 195 206"
color p1pie     "91 195 206"

