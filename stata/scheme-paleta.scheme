#include s2color

sequence 1500
label "Paleta estándar (turquesa, coral, ámbar, gris, naranja)"

* Estilo estándar de gráficas para Stata.
* Instalación: ver README (net install paleta, from(...))   y luego   set scheme paleta
* Colores en RGB; equivalen a paleta.json.

* --- Fondos
color background        white
color plotregion        white
color plotregion_line   white
color graphregion       white
color graphregion_line  white
color legend            white
color legend_line       white

* --- Texto
color heading           black
color subheading        black
color axis_title        black
color tick_label        black
color text              black
color body              black
color small_body        black
color key_label         black
* Texto dentro de las gráficas (etiquetas de puntos, barras y cajas de texto) en negro
color text_option       black
color label             black
color p1label        black
color p2label        black
color p3label        black
color p4label        black
color p5label        black
color p6label        black
color p7label        black
color p8label        black
color p9label        black
color p10label        black
color p11label        black
color p12label        black
color p13label        black
color p14label        black
color p15label        black

* --- Ejes y cuadrícula (solo líneas horizontales)
color axisline          black
color tick              black
color grid              "224 224 224"
color major_grid        "224 224 224"
linewidth major_grid    thin
linewidth grid          thin
* En Stata "hgrid" es la cuadrícula del eje x (líneas verticales) y "vgrid" la del eje y
yesno draw_major_hgrid  no
yesno draw_major_vgrid  yes
yesno draw_minor_hgrid  no
yesno draw_minor_vgrid  no
anglestyle vertical_tick horizontal

* --- Leyenda abajo
clockdir legend_position    6
clockdir by_legend_position 6

* --- Series (paleta categórica): el tono más oscuro (5) de cada familia.
* Solo 4: es el máximo que se distingue bien entre sí. Con más series use by().

* p1 = coral
color p1         "218 94 70"
color p1line     "218 94 70"
color p1lineplot "218 94 70"
color p1mark     "218 94 70"
color p1markfill "218 94 70"
color p1bar      "218 94 70"
color p1area     "218 94 70"
color p1box      "218 94 70"
color p1pie      "218 94 70"
color p1barline  white
color p1arealine white
color p1boxline  white
color p1pieline  white

* p2 = turquesa
color p2         "91 195 206"
color p2line     "91 195 206"
color p2lineplot "91 195 206"
color p2mark     "91 195 206"
color p2markfill "91 195 206"
color p2bar      "91 195 206"
color p2area     "91 195 206"
color p2box      "91 195 206"
color p2pie      "91 195 206"
color p2barline  white
color p2arealine white
color p2boxline  white
color p2pieline  white

* p3 = ambar
color p3         "231 165 68"
color p3line     "231 165 68"
color p3lineplot "231 165 68"
color p3mark     "231 165 68"
color p3markfill "231 165 68"
color p3bar      "231 165 68"
color p3area     "231 165 68"
color p3box      "231 165 68"
color p3pie      "231 165 68"
color p3barline  white
color p3arealine white
color p3boxline  white
color p3pieline  white

* p4 = gris
color p4         "150 150 150"
color p4line     "150 150 150"
color p4lineplot "150 150 150"
color p4mark     "150 150 150"
color p4markfill "150 150 150"
color p4bar      "150 150 150"
color p4area     "150 150 150"
color p4box      "150 150 150"
color p4pie      "150 150 150"
color p4barline  white
color p4arealine white
color p4boxline  white
color p4pieline  white

* --- Grosor de líneas y marcadores
linewidth p             medthick
symbol p                circle
symbolsize p            medsmall
